APP_NAME=Student Knowledge Hub API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=student_knowledge_hub
POSTGRES_USER=student_knowledge_hub
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_URL=postgresql+asyncpg://student_knowledge_hub:replace-with-strong-database-password@postgres:5432/student_knowledge_hub
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/student_knowledge_hub_test

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=skh
RATE_LIMIT_IN_MEMORY_FALLBACK=true
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_CONFIRM_MAX_REQUESTS=10
RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_MAX_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=20
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
ACCESS_TOKEN_REVOCATION_ENABLED=true

UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_TOTAL_SIZE=52428800
UPLOAD_MAX_FILE_COUNT=10

STORAGE_BACKEND=s3
STORAGE_ROOT=./storage
S3_BUCKET=
S3_REGION=fra1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRY_SECONDS=300

BACKUP_LOCAL_ROOT=./backups
BACKUP_FILENAME_PREFIX=student-knowledge-hub
BACKUP_TIMEOUT_SECONDS=600
BACKUP_VERIFY_RESTORE=true
BACKUP_RETENTION_LOCAL=7
BACKUP_OFFSITE_ENABLED=false
BACKUP_RETENTION_OFFSITE=14
BACKUP_S3_PREFIX=production/postgres
BACKUP_MAX_RESTORE_SIZE_BYTES=5368709120
BACKUP_RESTORE_CONFIRMATION_REQUIRED=true
BACKUP_RESTORE_API_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RUN_ON_START=true

PUBLIC_WEB_BASE_URL=http://localhost:3000

MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_API_TOKEN=
MAIL_API_URL=https://send.api.mailtrap.io/api/send
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Student Knowledge Hub
MAIL_STARTTLS=true
MAIL_TIMEOUT_SECONDS=10
EMAIL_OUTBOX_POLL_SECONDS=10
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_URL_PATH=/reset-password
EMAIL_VERIFICATION_URL_PATH=/verify-email

TELEGRAM_BOT_USERNAME=dev_minero_bot
TELEGRAM_LINK_SESSION_TTL_SECONDS=600
BACKEND_SERVICE_NAME=backend-api
BOT_SERVICE_NAME=telegram-bot
INTERNAL_AUTH_SECRET=replace-with-long-random-secret
INTERNAL_AUTH_TTL_SECONDS=300
TELEGRAM_EVENT_PUSH_ENABLED=false
BOT_INTERNAL_BASE_URL=
BOT_INTERNAL_EVENT_PATH=/internal/events
BOT_INTERNAL_TIMEOUT_SECONDS=10
TELEGRAM_EVENT_POLL_SECONDS=10
TELEGRAM_EVENT_BATCH_SIZE=50
TELEGRAM_EVENT_MAX_ATTEMPTS=5

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
CACHE_TTL_STATS_SECONDS=300
CACHE_TTL_TRENDING_SECONDS=300

RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true

PILOT_UNIVERSITY_REQUIRED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_FULL_NAME=Platform Admin
