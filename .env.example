APP_NAME=Student Knowledge Hub API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/student_knowledge_hub
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_TOTAL_SIZE=52428800
UPLOAD_MAX_FILE_COUNT=10
STORAGE_BACKEND=s3
STORAGE_ROOT=./storage
S3_BUCKET=
S3_REGION=fra1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRY_SECONDS=300
PUBLIC_WEB_BASE_URL=http://localhost:3000
REDIS_URL=redis://redis:6379/0
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
PILOT_UNIVERSITY_REQUIRED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_FULL_NAME=Platform Admin
